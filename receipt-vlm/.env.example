VLLM_BASE_URL=http://localhost:8001/v1
RECEIPT_VLM_MODEL=outputs/merged
# Telegram example client (examples/telegram_bot_client.py)
TELEGRAM_BOT_TOKEN=
EXTRACT_API_URL=http://localhost:8000/extract
