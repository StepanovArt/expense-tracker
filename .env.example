# ==============================================
# TELEGRAM BOT CONFIGURATION
# ==============================================
# Token obtenido de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# ==============================================
# LLM CONNECTOR CONFIGURATION
# ==============================================
# Conector LLM a usar: ollama | gemini
LLM_CONNECTOR=ollama

# --- Ollama ---
# Nombre del modelo a usar (debe estar descargado en Ollama)
OLLAMA_MODEL=qwen3:1.7b

# Timeout para generación (en segundos)
OLLAMA_TIMEOUT=45

# --- Gemini ---
# API key de Google Gemini (requerida si LLM_CONNECTOR=gemini)
GEMINI_API_KEY=

# Modelo de Gemini a usar
GEMINI_MODEL=gemini-2.0-flash

# ==============================================
# GOOGLE SHEETS CONFIGURATION
# ==============================================
# Opción A — contenido del JSON de credenciales (recomendado para Railway/cloud)
# Pega aquí el contenido completo del archivo service-account.json en una sola línea
GOOGLE_CREDENTIALS_JSON=

# Opción B — ruta al archivo JSON (para uso local / Raspberry Pi)
# Solo se usa si GOOGLE_CREDENTIALS_JSON está vacío
GOOGLE_CREDENTIALS_PATH=/home/pi/.credentials/google_sheets.json

# ID del spreadsheet (extraído de la URL)
# https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
SPREADSHEET_ID=

# Nombre de la pestaña donde se registrarán los gastos
SHEET_NAME=Gastos

# ==============================================
# CATEGORÍAS PERMITIDAS
# ==============================================
# Lista de categorías válidas separadas por coma
EXPENSE_CATEGORIES=Supermercado,Salidas,Juntadas,Suplementos,Compras

# Descripciones de cada categoría en JSON — guían al LLM para clasificar correctamente.
# Clave = nombre exacto de la categoría, valor = ejemplos de qué incluye.
# Ejemplo con las 8 categorías tipo:
# EXPENSE_CATEGORY_DESCRIPTIONS={"Vivienda": "alquiler, expensas, utilities del hogar", "Comida": "supermercado, verdulería, fiambrería, compras de alimentos para el hogar (NO bares ni salidas)", "Compras": "ropa, tecnología, Amazon, artículos del hogar", "Suscripciones": "ChatGPT, Spotify, iCloud, apps, servicios digitales", "Ocio": "cine, bares, cafeterías, restaurantes en salidas sociales, eventos, juegos, entretenimiento", "Educación": "universidad, cursos, libros, exámenes", "Personal": "peluquería, cuidado personal, regalos", "Otros": "solo si no entra en ninguna categoría anterior"}
EXPENSE_CATEGORY_DESCRIPTIONS=

# ==============================================
# ACCESS CONTROL
# ==============================================
# Tu Telegram user ID (obtenlo con @userinfobot). Requerido: sin esto el bot no arranca.
ALLOWED_USER_ID=

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directorio donde se guardarán los archivos de log
# Default: logs/ (relativo al directorio de ejecución)
# Producción: /var/log/telegram-bot-gastos-llm
LOG_DIR=logs
